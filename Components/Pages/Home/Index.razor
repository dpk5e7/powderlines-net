@page "/"
@page "/home"

@inject ISnotelService _snotelService

<PageTitle>Powderlines</PageTitle>

<h1>Powderlines</h1>

<p>Use our free API for accessing SNOTEL station data. Our API is useful for finding current snow levels in mountainous regions across the United States. @stationCount SNOTEL stations are available.</p>

<p>
	Backcountry travel is inherently dangerous. This site makes no suggestions or promises in terms of
	safety. Remember to always travel with the 10 essentials, including avalanche gear &mdash;
	beacon, shovel and probe and good partners. Ski and ride safe!
</p>

<LeafletMap />

@code {
	private int stationCount = 0;

	protected override async Task OnInitializedAsync()
	{
		stationCount = await _snotelService.GetNumberOfStationsAsync("all");
	}
}
